{
  "name": "Token Overage Alert",
  "description": "\u05de\u05ea\u05e8\u05d9\u05e2 \u05db\u05d0\u05e9\u05e8 \u05de\u05e0\u05d5\u05d9 \u05d7\u05d5\u05e8\u05d2 \u05de-90% \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"tokens_consumed_this_month\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Subscription"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "token_overage_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateNotifications",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateNotifications"
  }
}