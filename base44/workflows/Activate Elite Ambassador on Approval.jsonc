{
  "name": "Activate Elite Ambassador on Approval",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"active\") and (.trigger.data.track == \"elite\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "AmbassadorApplication"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "activate_elite_ambassador_on_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "activateEliteAmbassador",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "activateEliteAmbassador"
  }
}